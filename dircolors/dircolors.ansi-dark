# unimportant files e.g. backup,log,swp,compiled,machine
.bak    02;37
.old    02;37
.orig   02;37
.save   02;37
.swp    02;37
.swo    02;37
.log    02;37
*~      02;37
*,v     02;37
.tmp    02;37
.out    02;37
.zwc    02;37
.o      02;37
.pyc    02;37
.class  02;37
.part   02;37
# notable files to stand out more or less
*Dockerfile     01
*readme         01
*readme.txt     01
*readme.md      01
.ini    97
.json   97
.yml    97
.yaml   97
.conf   97
.cfg    97
.toml   97

# testing
.ANSI-30-black  30
.ANSI-31-red    31
.ANSI-32-green  32
.ANSI-33-yellow 33
.ANSI-34-blue   34
.ANSI-35-magenta 35
.ANSI-36-cyan   36
.ANSI-37-white  37

.ANSI-01.30-bld.black   01;30
